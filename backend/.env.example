NODE_ENV=production
PORT=3100

# HTTPS interno. El PFX y su contraseña solo existen en el servidor.
TLS_ENABLED=true
TLS_PFX_PATH=C:\ProgramData\ServiceMET\tls\servicemet-api.pfx
TLS_PFX_PASSWORD=cambiar_por_la_contrasena_del_pfx

# SQL Server. Estas credenciales nunca deben enviarse a Flutter.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=DataMET_prueba
DB_USER=ServiceMET
DB_PASSWORD=cambiar_esta_contrasena
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10

# Base de los formularios adicionales (form_rim y form_bitrix), en la misma
# instancia de SQL Server. La crea sql/012_create_servicios_extras.sql.
EXTRAS_DB_NAME=servicios_extras

# Use un secreto aleatorio largo (al menos 32 caracteres).
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_32_caracteres
JWT_TTL_SECONDS=28800

# Opcional: lista separada por comas. Las apps móviles no envían Origin.
CORS_ORIGINS=
TRUST_PROXY=false

# ── Bitrix24 (oportunidades comerciales → CRM › Prospectos) ──────────────
# Webhook entrante del Bitrix24 de METRICA (permiso: crm). Es un secreto: solo
# vive en el .env del servidor; nunca en Flutter ni en Git. Sin él, la API
# funciona igual y las rutas /api/bitrix responden 503.
BITRIX_WEBHOOK_URL=
# Alternativa a la URL completa:
# BITRIX_BASE_URL=https://TU_PORTAL.bitrix24.es
# BITRIX_USER_ID=
# BITRIX_WEBHOOK_SECRET=

# Las oportunidades se crean como Leads ("Prospectos"). Vacío = primera etapa
# en curso de crm.status.list (ENTITY_ID=STATUS), normalmente "Sin asignar".
# Copie solo valores que muestre `pnpm bitrix:discover`.
BITRIX_LEAD_STAGE_ID=
# Opcionales: fuente (crm.status.list ENTITY_ID=SOURCE) y responsable (ID de
# usuario de Bitrix24). Sin responsable, queda el usuario del webhook.
BITRIX_LEAD_SOURCE_ID=
BITRIX_LEAD_ASSIGNED_BY_ID=

# Evita duplicados con los campos estándar originatorId/originId del Lead.
BITRIX_DEDUPE_BY_ORIGIN=true
BITRIX_TIMEOUT_MS=15000
# text, bbcode o html: cómo se ve el comentario en la ficha del prospecto.
BITRIX_COMMENTS_FORMAT=text

# Campos personalizados de Prospectos (IDs reales de crm.item.fields, p. ej.
# ufCrm_1712345678). Vacío = el dato viaja dentro de `comments`.
# BITRIX_FIELD_TIPO_OPORTUNIDAD recibe la línea comercial de la app: VENTA,
# SOPORTE TECNICO o CALIBRACIÓN (deben existir con ese texto en la lista).
BITRIX_FIELD_SERVICEMET_UUID=
BITRIX_FIELD_TIPO_SERVICIO=
BITRIX_FIELD_SECA=
BITRIX_FIELD_CLIENTE_SERVICEMET=
BITRIX_FIELD_PLANTA=
BITRIX_FIELD_CODIGO_METRICA=
BITRIX_FIELD_TIPO_EQUIPO=
BITRIX_FIELD_MARCA=
BITRIX_FIELD_MODELO=
BITRIX_FIELD_SERIE=
BITRIX_FIELD_CAPACIDAD=
BITRIX_FIELD_DIVISION_ESCALA=
BITRIX_FIELD_UBICACION=
BITRIX_FIELD_TECNICO=
BITRIX_FIELD_TIPO_OPORTUNIDAD=
BITRIX_FIELD_PRIORIDAD=
# Lista "Ciudad del prospecto": el técnico la elige o se deduce del
# departamento de la planta. Si en Bitrix24 es obligatoria, configúrela.
BITRIX_FIELD_CIUDAD=
# Lista de meses: se llena con el mes del servicio.
BITRIX_FIELD_MES_SERVICIO=
